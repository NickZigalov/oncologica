def get_date_range():
    """
    Возвращает фиксированный диапазон дат (как в основном скрипте)
    """
    # Получаем текущую дату
    current_date = datetime.now()
    
    # Вычисляем дату 45 дней назад
    #start_date_obj = current_date - timedelta(days=180)
    
    # Задайте здесь нужные даты
    start_date = "2023-01-01"  # Дата начала в формате ГГГГ-ММ-ДД
    end_date = "2028-01-01"    # Дата окончания в формате ГГГГ-ММ-ДД

    # Форматируем даты в строки ГГГГ-ММ-ДД
    #start_date = start_date_obj.strftime("%Y-%m-%d")
    #end_date = current_date.strftime("%Y-%m-%d")
    
    # Добавляем время к датам для Bitrix24
    start_datetime = f"{start_date}T00:00:00+03:00"
    end_datetime = f"{end_date}T23:59:59+03:00"
    
    print(f"Диапазон дат: с {start_datetime} по {end_datetime}")
    
    return start_datetime, end_datetime

def get_bitrix_contact_ids_by_date(start_date, end_date):
    """
    Получение ID контактов из Bitrix24 с фильтрацией по DATE_CREATE
    Возвращает множество ID контактов
    """
    all_contact_ids = set()
    last_id = 0
    batch_count = 0
    max_batches = 1000
    
    print(f"Начинаем получение ID контактов из Bitrix24 за период {start_date} - {end_date}...")
    
    # Базовый фильтр по дате создания
    base_filter = {
        ">DATE_CREATE": start_date,
        "<=DATE_CREATE": end_date
    }
    
    while batch_count < max_batches:
        batch_count += 1
        print(f"Пакет {batch_count}, последний ID: {last_id}")
        
        # Добавляем фильтр по ID для пагинации
        current_filter = base_filter.copy()
        if last_id > 0:
            current_filter[">ID"] = str(last_id)
        
        payload = {
            "SELECT": ["ID"],
            "FILTER": current_filter,
            "ORDER": {"ID": "ASC"},
        }
        
        try:
            response = requests.post(
                bitrix_url,
                headers={
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                data=json.dumps(payload, ensure_ascii=False),
                timeout=60
            )
            
            if response.status_code != 200:
                print(f"Ошибка HTTP {response.status_code}")
                break
                
            result = response.json()
            
            if 'error' in result:
                print(f"Ошибка Bitrix24: {result['error']}")
                break
                
            if 'result' not in result:
                print("Нет поля 'result' в ответе")
                break
                
            contacts_batch = result['result']
            
            if not contacts_batch:
                print("Пустой результат - завершение")
                break
            
            # Добавляем ID в множество
            for contact in contacts_batch:
                contact_id = contact.get('ID')
                if contact_id:
                    all_contact_ids.add(int(contact_id))
            
            # Сохраняем последний ID для следующего запроса
            last_id = int(contacts_batch[-1].get('ID', 0))
            
            print(f"Получено {len(contacts_batch)} ID контактов (всего: {len(all_contact_ids)})")
            
            # Если получено меньше 50 записей, значит это последний пакет
            if len(contacts_batch) < 50:
                print("Получено меньше 50 записей - завершение")
                break
            
            # Пауза между запросами
            time.sleep(0.3)
            
        except Exception as e:
            print(f"Ошибка: {e}")
            break
    
    print(f"Всего получено ID контактов из Bitrix24 за период: {len(all_contact_ids)}")
    return all_contact_ids

def get_db_contact_ids_by_date(start_date, end_date):
    """
    Получение ID контактов из базы данных с фильтрацией по DATE_CREATE
    Возвращает множество ID контактов
    """
    conn_params = {
        'host': host,
        'port': port,
        'database': database,
        'user': db_user,
        'password': db_password
    }
    
    conn = None
    cursor = None
    
    try:
        conn = psycopg2.connect(**conn_params)
        cursor = conn.cursor()
        
        # Проверяем существование таблицы
        cursor.execute("""
            SELECT EXISTS (
                SELECT FROM information_schema.tables 
                WHERE table_schema = 'bitrix' 
                AND table_name = 'raw_contact'
            );
        """)
        
        table_exists = cursor.fetchone()[0]
        
        if not table_exists:
            print("Таблица bitrix.raw_contact не существует")
            return set()
        
        # Преобразуем строки дат в формат PostgreSQL
        # Убираем временную зону и приводим к timestamp
        start_date_db = start_date.replace('T', ' ').replace('+03:00', '')
        end_date_db = end_date.replace('T', ' ').replace('+03:00', '')
        
        # Получаем ID из таблицы за указанный период
        query = """
            SELECT id 
            FROM bitrix.raw_contact
            WHERE date_create >= %s 
            AND date_create <= %s;
        """
        
        cursor.execute(query, (start_date_db, end_date_db))
        db_ids = {row[0] for row in cursor.fetchall()}
        
        print(f"Всего ID контактов в базе данных за период: {len(db_ids)}")
        return db_ids
        
    except Exception as e:
        print(f"Ошибка при получении ID из базы данных: {e}")
        return set()
    finally:
        if cursor:
            cursor.close()
        if conn:
            conn.close()

def delete_contacts_from_db(contact_ids_to_delete):
    """
    Удаление контактов из базы данных по списку ID
    Возвращает количество удаленных записей
    """
    if not contact_ids_to_delete:
        print("Нет контактов для удаления")
        return 0
    
    print(f"Начинаем удаление {len(contact_ids_to_delete)} контактов из базы данных...")
    
    conn_params = {
        'host': host,
        'port': port,
        'database': database,
        'user': db_user,
        'password': db_password
    }
    
    conn = None
    cursor = None
    
    try:
        conn = psycopg2.connect(**conn_params)
        cursor = conn.cursor()
        
        # Преобразуем множество в список для batch операции
        ids_to_delete = list(contact_ids_to_delete)
        total_deleted = 0
        
        # Удаляем пакетами для оптимизации
        batch_size = 100
        for i in range(0, len(ids_to_delete), batch_size):
            batch = ids_to_delete[i:i + batch_size]
            
            # Создаем SQL запрос с плейсхолдерами
            placeholders = ','.join(['%s'] * len(batch))
            delete_sql = f"DELETE FROM bitrix.raw_contact WHERE id IN ({placeholders});"
            
            cursor.execute(delete_sql, batch)
            deleted_count = cursor.rowcount
            total_deleted += deleted_count
            
            conn.commit()
            print(f"Удалено пакет из {len(batch)} контактов (удалено: {deleted_count})")
        
        print(f"✅ Всего удалено контактов: {total_deleted}")
        return total_deleted
        
    except Exception as e:
        print(f"❌ Ошибка при удалении контактов: {e}")
        if conn:
            conn.rollback()
        return 0
    finally:
        if cursor:
            cursor.close()
        if conn:
            conn.close()

def get_db_statistics_by_date(start_date, end_date):
    """
    Получение статистики по контактам в базе данных за период
    """
    conn_params = {
        'host': host,
        'port': port,
        'database': database,
        'user': db_user,
        'password': db_password
    }
    
    conn = None
    cursor = None
    
    try:
        conn = psycopg2.connect(**conn_params)
        cursor = conn.cursor()
        
        # Преобразуем строки дат в формат PostgreSQL
        start_date_db = start_date.replace('T', ' ').replace('+03:00', '')
        end_date_db = end_date.replace('T', ' ').replace('+03:00', '')
        
        # Получаем общее количество и диапазон дат
        query = """
            SELECT 
                COUNT(*) as total_count,
                MIN(date_create) as min_date,
                MAX(date_create) as max_date
            FROM bitrix.raw_contact
            WHERE date_create >= %s 
            AND date_create <= %s;
        """
        
        cursor.execute(query, (start_date_db, end_date_db))
        result = cursor.fetchone()
        
        if result:
            total_count, min_date, max_date = result
            print(f"Статистика по базе данных за период:")
            print(f"  - Всего контактов: {total_count}")
            if min_date:
                print(f"  - Минимальная дата создания: {min_date}")
            if max_date:
                print(f"  - Максимальная дата создания: {max_date}")
        
        return total_count if result else 0
        
    except Exception as e:
        print(f"Ошибка при получении статистики: {e}")
        return 0
    finally:
        if cursor:
            cursor.close()
        if conn:
            conn.close()

def compare_and_clean():
    """
    Основная функция сравнения и очистки
    """
    print("=== ЗАПУСК СКРИПТА ДЛЯ СВЕРКИ И ОЧИСТКИ КОНТАКТОВ ===")
