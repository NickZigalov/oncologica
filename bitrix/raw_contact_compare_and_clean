    # Шаг 6: Проверяем результат
    print("\n=== ШАГ 6: Проверка результата ===")
    remaining_db_ids = get_db_contact_ids_by_date(start_date, end_date)
    remaining_total = get_db_statistics_by_date(start_date, end_date)
    
    print(f"Осталось контактов в базе данных за период: {len(remaining_db_ids)}")
    
    end_time = datetime.now()
    duration = end_time - start_time
    
    print("\n=== ЗАВЕРШЕНО ===")
    print(f"Общее время выполнения: {duration}")
    print(f"Удалено контактов: {deleted_count}")
    
    if len(remaining_db_ids) == len(bitrix_ids):
        print("✅ База данных полностью синхронизирована с Bitrix24 за указанный период!")
    else:
        print(f"⚠️ Количество контактов не совпадает: DB={len(remaining_db_ids)}, Bitrix={len(bitrix_ids)}")
        print("Возможно, в базе есть контакты, которые были созданы в другой период")

